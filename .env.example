# Server
NODE_ENV=development
PORT=3000

# Comma-separated list of origins allowed to call this API (the frontend's URL(s))
ALLOWED_ORIGINS=http://localhost:5173

# Postgres connection string for the Supabase-hosted database (use the pooled/transaction
# connection string from the Supabase project settings, not the direct connection)
DATABASE_URL=postgres://user:password@host:5432/postgres

# Supabase project — used only to verify user access tokens (Auth) and to read/write the
# private documents bucket (Storage). The service role key is backend-only; never expose it
# to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_DOCUMENTS_BUCKET=documents

# Email domain allowed to sign up / log in (server-side enforcement point)
ALLOWED_EMAIL_DOMAIN=al.insper.edu.br
